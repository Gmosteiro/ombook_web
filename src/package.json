{
  "name": "ombook",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "gen:types": "dotenv -e .env -- sh -c 'openapi-typescript \"$VITE_API_URL/v3/api-docs\" -o types/openapi.ts'",
    "test": "playwright test",
    "test:report": "playwright test --reporter=list,allure-playwright",
    "test:allure": "npm run test:report && npm run allure:generate",
    "allure:generate": "node ./scripts/allure-runner.cjs generate ./allure-results --clean -o ./allure-report",
    "allure:open": "node ./scripts/allure-runner.cjs open ./allure-report",
    "allure:serve": "node ./scripts/allure-runner.cjs serve ./allure-results"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@react-router/node": "^7.7.1",
    "@react-router/serve": "^7.7.1",
    "isbot": "^5.1.27",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.543.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@playwright/test": "^1.57.0",
    "@react-router/dev": "^7.7.1",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@types/recharts": "^2.0.1",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^2.15.1",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^10.0.0",
    "openapi-typescript": "^7.10.1",
    "playwright": "^1.57.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.3",
    "util": "^0.12.5",
    "vite": "^6.3.3",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
